# Public site URL, used for canonical and Open Graph links and as the OAuth redirect host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Containerized PostgreSQL connection string (matches docker-compose.yml).
DATABASE_URL=postgresql://surshongi:surshongi_pass@localhost:5432/surshongi_db

# Google OAuth 2.0 SSO credentials
# Authorized redirect URI: http://localhost:3000/api/google-oauth/callback-chatbot
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Gmail alerts (new orders, completed orders, chat messages unseen for 1 hour).
# SMTP_PASS must be a Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where uploaded audio/images are stored (defaults to public/uploads).
# UPLOAD_DIR=
